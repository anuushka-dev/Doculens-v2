DOCULENS_ENVIRONMENT=development
DOCULENS_LOG_LEVEL=INFO
DOCULENS_PORT=8000
DOCULENS_MAX_UPLOAD_BYTES=20971520
DOCULENS_MAX_PDF_PAGES=350
DOCULENS_MAX_EXTRACTED_CHARS=4000000

# Ollama must be running and this exact model must already be pulled.
DOCULENS_OLLAMA_BASE_URL=http://127.0.0.1:11434
DOCULENS_OLLAMA_MODEL=qwen3.5:4b
DOCULENS_OLLAMA_TIMEOUT_SECONDS=120
DOCULENS_OLLAMA_NUM_CTX=16384
DOCULENS_OLLAMA_NUM_BATCH=128
DOCULENS_OLLAMA_NUM_PREDICT=1024
DOCULENS_OLLAMA_TEMPERATURE=0
DOCULENS_OLLAMA_SEED=42

# hybrid = semantic + keyword search; first use downloads MiniLM weights.
# lexical = explicit keyword-only offline option, with a visible UI notice.
DOCULENS_RETRIEVAL_MODE=hybrid
DOCULENS_RETRIEVAL_TOP_K=8
DOCULENS_EVIDENCE_THRESHOLD=0.25
DOCULENS_MAX_CONTEXT_CHARS=8000

# Sessions live in this single application process and expire on restart.
DOCULENS_DOCUMENT_TTL_SECONDS=3600
DOCULENS_MAX_CACHED_DOCUMENTS=8
DOCULENS_MAX_CACHED_TEXT_BYTES=67108864
DOCULENS_EXTRACTION_MAX_REPAIR_ATTEMPTS=1

# Ollama-server process settings are separate from this API configuration.
# Start Ollama with LLAMA_ARG_CACHE_RAM=0, OLLAMA_NUM_PARALLEL=1 and
# OLLAMA_MAX_LOADED_MODELS=1 (see README). Compose already applies these.
